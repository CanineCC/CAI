<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cai.Web</RootNamespace>
  </PropertyGroup>

  <!-- ★ The rate-limiting policy's NUMBERS are asserted where they are declared: a daily ceiling of 240 cannot
       be exercised by a test, so the constant and its path list are checked directly rather than inferred. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cai.Tests" />
  </ItemGroup>
  <!-- The host: the calculator UI and the shared API edge. The registry and the Noise Standard each live in their
       own project and are mapped in here, so neither grows into the other by proximity. -->
  <ItemGroup>
    <ProjectReference Include="..\Cai.Scoring\Cai.Scoring.csproj" />
    <ProjectReference Include="..\Cai.Delivery\Cai.Delivery.csproj" />
    <ProjectReference Include="..\Cai.Web.Registry\Cai.Web.Registry.csproj" />
    <ProjectReference Include="..\Cai.Web.Noise\Cai.Web.Noise.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
  </ItemGroup>
</Project>
